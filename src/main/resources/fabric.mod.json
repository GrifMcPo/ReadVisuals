{
  "schemaVersion": 1,
  "id": "readvisuals",
  "version": "${version}",
  "name": "ReadVisuals",
  "description": "Красивый таймер с рамкой для Minecraft",
  "authors": ["ReadVisuals"],
  "contact": {
    "homepage": "https://github.com/yourusername/ReadVisuals",
    "sources": "https://github.com/yourusername/ReadVisuals"
  },
  "license": "MIT",
  "icon": "assets/readvisuals/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.readvisuals.ReadVisuals"
    ],
    "modmenu": [
      "com.readvisuals.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "modmenu": "*"
  }
}
